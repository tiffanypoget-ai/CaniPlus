{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "cani-plus.vercel.app" }
      ],
      "destination": "https://app.caniplus.ch/:path*",
      "permanent": true
    },
    {
      "source": "/((?!admin$|connexion$|assets/|service-worker\\.js$|manifest\\.json$|icons/|images/|api/).*)",
      "has": [
        { "type": "host", "value": "app.caniplus.ch" }
      ],
      "destination": "https://caniplus.ch/espace",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/propose-themes",
      "schedule": "0 5 * * 1"
    }
  ]
}
